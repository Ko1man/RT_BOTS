generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id String @id @unique @default(uuid())
  name String @unique
  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  users UserGroup[] 

  attendances  Attendance[]

  @@map("groups")
  
}

model UserGroup {
  id      String @id @default(uuid())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String

  Schedule Schedule[]

  @@unique([userId, groupId]) // чтобы не дублировались
  @@map("user_groups")
}

model User{
  id String @id @unique @default(uuid())
  fullName String 
  name String
  phone String
  email String @unique()
  password String
  role ROLE @default(STUDENT)
  avatar String?
  birthday DateTime
  on_check CHECK_STATUS @default(PENDING)
  email_verified Boolean @default(false)

  groups UserGroup[]

  news     News?   @relation(fields: [newsID], references: [id], onDelete: Cascade)
  newsID   String? 

  attendances  Attendance[]

  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model News{
  id String @id @unique @default(uuid())
  title String
  views Int  @default(0)
  short_description String
  full_description String
  news_photo String[] @default([])

  user User[]
  userId String?

  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

}



model Attendance{
  id String @id @unique @default(uuid())
  is_on_lesson Boolean @default(false)

  userId      String
  groupId     String
  lessonNumberId String?

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group        Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lessonNumber LessonNumber? @relation(fields: [lessonNumberId], references: [id], onDelete: Cascade)

  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, groupId, lessonNumberId])
  
}

model LessonNumber{
  id String @id @unique @default(uuid())

  lessonNumber String
  shift String

  Attendance Attendance[]
  attendanceId String?

  updatedAt DateTime @default(now()) @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)

  @@index([email])
}

model DayOfWeek {
  id       Int        @id @default(autoincrement())
  name     String     // Понедельник, Вторник и т.д.
  schedule Schedule[]
}

model Schedule {
  id        Int       @id @default(autoincrement())
  subject   String
  startTime DateTime
  endTime   DateTime

  group   UserGroup  @relation(fields: [groupId], references: [id])
  groupId String

  day     DayOfWeek @relation(fields: [dayId], references: [id])
  dayId   Int
}

enum ROLE{
  TEACHER
  STUDENT
  ADMIN
  DISPETCHER
  CURATOR
}

enum CHECK_STATUS{
  APPROVED
  PENDING
}
